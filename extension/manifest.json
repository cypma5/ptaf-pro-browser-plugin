{
  "manifest_version": 3,
  "name": "PT AF bulk actions",
  "version": "1.0.0",
  "description": "Add or remove one action on every rule of the PT Application Firewall policy or template you have open.",
  "content_scripts": [
    {
      "matches": ["https://*.af.appsec.ptsecurity.ru/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://*.af.appsec.ptsecurity.ru/*"],
  "web_accessible_resources": [
    {
      "resources": ["content/content.css"],
      "matches": ["https://*.af.appsec.ptsecurity.ru/*"]
    }
  ]
}
