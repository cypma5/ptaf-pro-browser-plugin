{
  "manifest_version": 3,
  "name": "PT AF PRO Browser Extension",
  "version": "1.0.113",
  "description": "Add or remove actions on open PT Application Firewall rules. Export and import rules and security events as JSON.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PT AF PRO Browser Extension",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js", "content/dashboard-overview.js", "content/dashboard-events.js", "content/dashboard-matches.js", "content/dashboard.js", "content/compare.js", "content/traffic.js", "content/x509.js", "content/certificates.js", "content/policies.js", "content/transfer.js", "content/events.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["content/content.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
