{
  "manifest_version": 3,
  "name": "PT AF PRO Browser Extension",
  "version": "1.0.68",
  "description": "Add or remove one action on every rule, or on rules you select, of the PT Application Firewall policy or template you have open. Export a rule as JSON and import it on another installation.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "PT AF PRO Browser Extension",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js", "content/compare.js", "content/traffic.js", "content/x509.js", "content/certificates.js", "content/transfer.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["content/content.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
