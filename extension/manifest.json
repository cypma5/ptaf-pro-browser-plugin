{
  "manifest_version": 3,
  "name": "PT AF PRO Browser Extension",
  "version": "1.0.14",
  "description": "Add or remove one action on every rule of the PT Application Firewall policy or template you have open.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js", "content/traffic.js", "content/x509.js", "content/certificates.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["content/content.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
